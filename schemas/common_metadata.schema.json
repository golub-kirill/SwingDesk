{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swingdesk/schemas/common_metadata.schema.json",
  "title": "Common Metadata",
  "description": "Единый блок метаданных, обязательный для каждого объекта SwingDesk. Кодирует §9 мастер-ТЗ. Русские значения допустимы в текстовых полях; идентификаторы и enum — английские.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "object_type",
    "version",
    "schema_version",
    "status",
    "title_ru",
    "title_en"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Стабильный идентификатор объекта в формате OBJECT_TYPE.DOMAIN.CONCEPT.NUMBER.",
      "pattern": "^[A-Z][A-Z_]*\\.[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[0-9]{3}$",
      "examples": [
        "RULE.TREND.PRICE_ABOVE_EMA.001",
        "FEATURE.VOLATILITY.ATR.001",
        "PARAMETER.ATR.PERIOD.001"
      ]
    },
    "object_type": {
      "type": "string",
      "description": "Тип объекта из онтологии (03_Domain_Ontology).",
      "enum": [
        "data_field", "feature", "indicator", "rule", "event", "state",
        "state_machine", "regime", "setup", "trigger", "constraint",
        "strategy", "decision", "order", "fill", "position", "trade",
        "outcome_definition", "expectation_definition", "expectation_estimate",
        "parameter", "policy", "evidence_record", "hypothesis",
        "validation_plan", "validation_run", "requirement", "test_case"
      ]
    },
    "version": {
      "type": "string",
      "description": "Semver версии объекта.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "description": "Жизненный цикл статуса объекта (§9.2). VALIDATED недопустим без ссылки на Validation Record — см. REQ-EVIDENCE-001; проверяется вне схемы.",
      "enum": [
        "DRAFT", "REVIEWED", "SPECIFIED", "IMPLEMENTABLE", "IMPLEMENTED",
        "IMPLEMENTATION_VERIFIED", "VALIDATION_PENDING", "VALIDATED",
        "MONITORED", "REJECTED", "DEPRECATED", "SUPERSEDED", "DISABLED"
      ]
    },
    "title_ru": { "type": "string", "minLength": 1 },
    "title_en": { "type": "string", "minLength": 1 },
    "summary": {
      "type": ["string", "null"],
      "description": "Краткое нейтральное описание объекта."
    },
    "owner": { "type": ["string", "null"] },
    "created_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "reviewed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "description": "Ссылки на источники (provenance). Пустой массив допустим на статусе DRAFT.",
      "items": { "type": "string" }
    },
    "course_module_refs": {
      "type": "array",
      "description": "Ссылки на модули уроков, из которых извлечён объект.",
      "items": { "type": "string" }
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z]+-[0-9]{3}$"
      }
    },
    "test_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "change"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "at": { "type": ["string", "null"], "format": "date-time" },
          "author": { "type": ["string", "null"] },
          "change": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$comment": "Ограничения, не выразимые чистой схемой (проверяются статической валидацией каталогов): (1) status=VALIDATED требует непустого validation-record ref в объекте-владельце (REQ-EVIDENCE-001); (2) NUMBER в id уникален в пределах OBJECT_TYPE.DOMAIN.CONCEPT; (3) supersedes/superseded_by ссылаются на существующие id; (4) при DEPRECATED/SUPERSEDED поле superseded_by обязано быть заполнено."
}
