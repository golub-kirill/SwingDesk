{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swingdesk/schemas/parameter.schema.json",
  "title": "Parameter",
  "description": "Форма параметра SwingDesk (§14 мастер-ТЗ, документ 10). Все пороги живут здесь, а не в коде/тексте/имени стратегии.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata", "purpose", "category", "data_type", "unit",
    "value", "status", "allowed_domain", "scope", "source",
    "calibration", "robustness", "consumers", "runtime_blocking"
  ],
  "properties": {
    "metadata": {
      "$ref": "common_metadata.schema.json",
      "description": "Общий блок метаданных."
    },
    "purpose": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "description": "Категория источника — определяет, как параметр вправе получать значение.",
      "enum": [
        "DEFINITION_FIXED", "MARKET_CONVENTION_SEED", "BOOK_OR_PRACTITIONER_SEED",
        "EMPIRICAL_THRESHOLD", "ADAPTIVE_PARAMETER", "RISK_POLICY",
        "PORTFOLIO_POLICY", "EXECUTION_CONSTRAINT", "BROKER_CONSTRAINT",
        "REGULATORY_CONSTRAINT"
      ]
    },
    "data_type": {
      "type": "string",
      "enum": ["DECIMAL", "INTEGER", "RATIO", "PERCENT", "BOOLEAN", "DURATION_BARS", "CATEGORY"]
    },
    "unit": {
      "type": "string",
      "description": "Единица измерения; RATIO/PRICE/PERCENT/BARS/CURRENCY/NONE и т.п."
    },
    "value": {
      "type": ["number", "integer", "boolean", "string", "null"],
      "description": "Значение параметра. null при status=UNSET."
    },
    "status": {
      "type": "string",
      "description": "Статус значения параметра (не путать с metadata.status — статусом объекта).",
      "enum": [
        "UNSET", "CANDIDATE", "SEEDED", "CALIBRATING", "PROVISIONAL",
        "VALIDATED", "LOCKED", "MONITORED", "DEPRECATED", "REJECTED"
      ]
    },
    "allowed_domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] }
      }
    },
    "candidate_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "step": { "type": ["number", "null"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markets", "instrument_types", "timeframes"],
      "properties": {
        "markets": { "type": "array", "items": { "type": "string", "enum": ["US", "CA"] } },
        "instrument_types": { "type": "array", "items": { "type": "string", "enum": ["stock", "ETF"] } },
        "timeframes": { "type": "array", "items": { "type": "string" } },
        "regimes": { "type": "array", "items": { "type": "string" } },
        "liquidity_buckets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global_default": { "type": ["number", "integer", "boolean", "string", "null"] },
        "market_override_allowed": { "type": "boolean" },
        "asset_type_override_allowed": { "type": "boolean" },
        "regime_override_allowed": { "type": "boolean" },
        "instrument_override_allowed": {
          "type": "boolean",
          "description": "По умолчанию false — запрет подгонки под отдельный тикер."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "INTERNAL_HYPOTHESIS", "BOOK", "PRACTITIONER_METHOD",
            "MARKET_CONVENTION", "ACADEMIC_RESEARCH", "EMPIRICAL_OBSERVATION",
            "EXCHANGE_SPECIFICATION", "BROKER_SPECIFICATION", "REGULATORY_SOURCE",
            "DATA_VENDOR_SPECIFICATION"
          ]
        },
        "reference": { "type": ["string", "null"] }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": ["string", "null"] },
        "primary_metric": { "type": ["string", "null"] },
        "secondary_metrics": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "train_period": { "type": ["string", "null"] },
        "validation_period": { "type": ["string", "null"] },
        "test_period": { "type": ["string", "null"] }
      }
    },
    "robustness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensitivity_required": { "type": "boolean" },
        "plateau_selection_required": { "type": "boolean" },
        "minimum_sample_size": {
          "type": ["integer", "null"],
          "description": "Обязан выводиться из расчёта мощности, а не назначаться круглым числом."
        }
      }
    },
    "consumers": {
      "type": "array",
      "description": "Правила/стратегии, читающие параметр. Пустой массив = кандидат на удаление (перепись мёртвых ручек).",
      "items": { "type": "string" }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "runtime_blocking": {
      "type": "boolean",
      "description": "Блокирует ли переход владельца в runtime, пока значение UNSET."
    }
  },
  "$comment": "Ограничения вне схемы (статическая валидация каталогов): (1) value=null тогда и только тогда, когда status=UNSET; (2) status=UNSET требует непустых purpose, unit, allowed_domain, calibration.method-намерения и заданного runtime_blocking; (3) category=BOOK_OR_PRACTITIONER_SEED НЕ может иметь status=VALIDATED без собственного validation record (REQ-EVIDENCE-001) — это prior, не доказательство; (4) для калибруемых категорий (EMPIRICAL_THRESHOLD/ADAPTIVE_PARAMETER) robustness.minimum_sample_size непуст и обоснован мощностью; (5) inheritance.instrument_override_allowed по умолчанию false; (6) риск-контроль в enabled:false несёт датированную ADR со сроком — REQ-RISK-001, проверяется отдельно."
}
